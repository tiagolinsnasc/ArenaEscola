<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
      https://maven.apache.org/xsd/maven-4.0.0.xsd">

<modelVersion>4.0.0</modelVersion>

<groupId>br.com.suaescola</groupId>
<artifactId>jogos-internos</artifactId>
<version>1.0.0</version>
<packaging>jar</packaging>

<name>Jogos Internos - Gestao de Partidas</name>
<description>Sistema Java/JavaFX para gerenciar jogos em equipe</description>

<properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <javafx.version>21.0.4</javafx.version>

    <!-- IMPORTANTE:
         Launcher chama MainApp -->
    <mainClass>br.com.suaescola.jogosinternos.Launcher</mainClass>
</properties>


<!-- ========================================================= -->
<!-- DEPENDÊNCIAS                                               -->
<!-- ========================================================= -->

<dependencies>

    <!-- ===================================================== -->
    <!-- JavaFX comum                                           -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
    </dependency>

    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-fxml</artifactId>
        <version>${javafx.version}</version>
    </dependency>


    <!-- ===================================================== -->
    <!-- JavaFX - Nativos Windows                              -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
        <classifier>win</classifier>
    </dependency>


    <!-- ===================================================== -->
    <!-- JavaFX - Nativos Linux                                -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
        <classifier>linux</classifier>
    </dependency>


    <!-- ===================================================== -->
    <!-- SQLite                                                 -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>3.46.1.3</version>
    </dependency>


    <!-- ===================================================== -->
    <!-- PDFBox                                                 -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>3.0.3</version>
    </dependency>


    <!-- ===================================================== -->
    <!-- ControlsFX                                             -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.controlsfx</groupId>
        <artifactId>controlsfx</artifactId>
        <version>11.2.1</version>
    </dependency>


    <!-- ===================================================== -->
    <!-- Testes                                                  -->
    <!-- ===================================================== -->

    <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>5.10.3</version>
        <scope>test</scope>
    </dependency>

</dependencies>


<!-- ========================================================= -->
<!-- BUILD                                                       -->
<!-- ========================================================= -->

<build>

    <finalName>jogos-internos</finalName>

    <plugins>

        <!-- ================================================= -->
        <!-- Compilador Java                                    -->
        <!-- ================================================= -->

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>

            <configuration>
                <release>21</release>
            </configuration>
        </plugin>


        <!-- ================================================= -->
        <!-- JavaFX Maven Plugin                                -->
        <!-- ================================================= -->

        <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <version>0.0.8</version>

            <configuration>
                <mainClass>${mainClass}</mainClass>
            </configuration>
        </plugin>


        <!-- ================================================= -->
        <!-- JUnit                                               -->
        <!-- ================================================= -->

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.3.1</version>
        </plugin>


        <!-- ================================================= -->
        <!-- FAT JAR MULTIPLATAFORMA                            -->
        <!-- ================================================= -->

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>

            <executions>
                <execution>

                    <phase>package</phase>

                    <goals>
                        <goal>shade</goal>
                    </goals>

                    <configuration>

                        <!-- Gera o JAR com as dependências -->
                        <shadedArtifactAttached>true</shadedArtifactAttached>

                        <shadedClassifier>shaded</shadedClassifier>

                        <!-- Não altera o pom.xml -->
                        <createDependencyReducedPom>false</createDependencyReducedPom>


                        <!-- ================================= -->
                        <!-- MANIFESTO                           -->
                        <!-- ================================= -->

                        <transformers>

                            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                <mainClass>${mainClass}</mainClass>
                            </transformer>

                            <!-- Necessário para algumas dependências -->
                            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                        </transformers>


                        <!-- ================================= -->
                        <!-- REMOVER ASSINATURAS               -->
                        <!-- ================================= -->

                        <filters>

                            <filter>
                                <artifact>*:*</artifact>

                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                </excludes>

                            </filter>

                        </filters>

                    </configuration>

                </execution>
            </executions>

        </plugin>

    </plugins>

</build>

</project>
