                  </ownedParameter>
                  <language>java</language>
                  <body>Alert alerta = new Alert(AlertType.WARNING);
     alerta.setTitle(&quot;Aviso&quot;);
     alerta.setHeaderText(null);
     alerta.setContentText(mensagem);
     alerta.showAndWait();
 </body>
                </ownedBehavior>
