                  <language>java</language>
                  <body>Evento e = new Evento();
     e.partidaId = partidaId;
     e.jogadorId = jogadorId;
     e.equipeId = equipeId;
     e.tipo = tipo;
     e.periodo = periodo;
     e.minutoSegundos = minutoSegundos;
