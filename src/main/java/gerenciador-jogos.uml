                <ownedAttribute xmi:id="_MY_Gwa-6EfGQj-CFeLdrDw" name="jogadoresA" visibility="private" type="_MLqccK-6EfGQj-CFeLdrDw" isOrdered="true" association="_Maoska-6EfGQj-CFeLdrDw">
