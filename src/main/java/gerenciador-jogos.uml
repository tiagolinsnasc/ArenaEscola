                </ownedAttribute>
                <ownedAttribute xmi:id="_MZCxIa-6EfGQj-CFeLdrDw" name="tocando" visibility="private">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#boolean"/>
                  <defaultValue xmi:type="uml:LiteralString" xmi:id="_MZCxIq-6EfGQj-CFeLdrDw" value="false"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_MZDYMa-6EfGQj-CFeLdrDw" name="cronometro" visibility="private" type="_MWsnwa-6EfGQj-CFeLdrDw" association="_Map6sa-6EfGQj-CFeLdrDw"/>
                <ownedAttribute xmi:id="_MZD_Qa-6EfGQj-CFeLdrDw" name="cartoesAmarelosPorJogador" visibility="private" isLeaf="true" isReadOnly="true">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                  <qualifier xmi:id="_MZEmUK-6EfGQj-CFeLdrDw">
                    <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                  </qualifier>
                  <defaultValue xmi:type="uml:LiteralString" xmi:id="_MZD_Qq-6EfGQj-CFeLdrDw" value="new HashMap&lt;>()"/>
                </ownedAttribute>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2CYK-6EfGQj-CFeLdrDw" name="inicializar" specification="_MX9MAK-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZ2CYa-6EfGQj-CFeLdrDw" name="partida" type="_MMTVoK-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ2CYq-6EfGQj-CFeLdrDw" name="equipeA" type="_MLbL4K-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ2CY6-6EfGQj-CFeLdrDw" name="equipeB" type="_MLbL4K-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ2CZK-6EfGQj-CFeLdrDw" name="jogadoresA" type="_MV59kK-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ2CZa-6EfGQj-CFeLdrDw" name="jogadoresB" type="_MV59kK-6EfGQj-CFeLdrDw"/>
                  <language>java</language>
                  <body>this.partida = partida;
     this.equipeA = equipeA;
     this.equipeB = equipeB;
     this.jogadoresA = jogadoresA;
     this.jogadoresB = jogadoresB;

     labelNomeA.setText(equipeA.getNome());
     labelNomeB.setText(equipeB.getNome());
     carregarEscudo(escudoA, equipeA.getEscudoPath());
     carregarEscudo(escudoB, equipeB.getEscudoPath());

     atualizarPlacar();
     atualizarPeriodoLabel();
     atualizarTempoLabel();

     cronometro = new Timeline(new KeyFrame(Duration.seconds(1), e -> tick()));
     cronometro.setCycleCount(Timeline.INDEFINITE);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2CZq-6EfGQj-CFeLdrDw" name="carregarEscudo" specification="_MX_BMK-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZ2CZ6-6EfGQj-CFeLdrDw" name="imageView" type="_MWyHUa-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ2CaK-6EfGQj-CFeLdrDw" name="caminho">
                    <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                  </ownedParameter>
                  <language>java</language>
                  <body>if (caminho != null &amp;&amp; new File(caminho).exists()) {
         imageView.setImage(new Image(new File(caminho).toURI().toString()));
     }
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2Caa-6EfGQj-CFeLdrDw" name="tick" specification="_ML5tAK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>if (segundosRestantes > 0) {
         segundosRestantes--;
         atualizarTempoLabel();
     }
     if (segundosRestantes == 0) {
         pausar();
         Alert alerta = new Alert(AlertType.INFORMATION);
         alerta.setTitle(&quot;Fim do período&quot;);
         alerta.setHeaderText(periodoAtual == 1 ? &quot;Fim do 1º tempo&quot; : &quot;Fim do 2º tempo&quot;);
         alerta.setContentText(periodoAtual == 1
                 ? &quot;Clique em \&quot;Avançar período\&quot; para iniciar o 2º tempo.&quot;
                 : &quot;A partida pode ser encerrada.&quot;);
         alerta.showAndWait();
     }
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2Caq-6EfGQj-CFeLdrDw" name="onIniciarPausar" specification="_ML6UEK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>if (tocando) {
         pausar();
     } else {
         cronometro.play();
         tocando = true;
         botaoIniciarPausar.setText(&quot;Pausar&quot;);
     }
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pcK-6EfGQj-CFeLdrDw" name="pausar" specification="_ML67Iq-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>cronometro.pause();
     tocando = false;
     botaoIniciarPausar.setText(&quot;Iniciar&quot;);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pca-6EfGQj-CFeLdrDw" name="onAvancarPeriodo" specification="_ML67I6-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>if (periodoAtual >= 2) {
         avisar(&quot;A partida já está no 2º tempo.&quot;);
         return;
     }
     pausar();
     periodoAtual = 2;
     segundosRestantes = DURACAO_TEMPO_SEGUNDOS;
     atualizarPeriodoLabel();
     atualizarTempoLabel();
     registrarLog(&quot;Início do 2º tempo.&quot;);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pcq-6EfGQj-CFeLdrDw" name="atualizarTempoLabel" specification="_ML8JQK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>int minutos = segundosRestantes / 60;
     int segundos = segundosRestantes % 60;
     labelTempo.setText(String.format(&quot;%02d:%02d&quot;, minutos, segundos));
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pc6-6EfGQj-CFeLdrDw" name="atualizarPeriodoLabel" specification="_ML8JQa-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>labelPeriodo.setText(periodoAtual == 1 ? &quot;1º Tempo&quot; : &quot;2º Tempo&quot;);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pdK-6EfGQj-CFeLdrDw" name="atualizarPlacar" specification="_ML8JQq-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>labelPlacar.setText(placarA + &quot; x &quot; + placarB);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pda-6EfGQj-CFeLdrDw" name="onGolA" specification="_ML8wUK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>registrarGol(equipeA, jogadoresA, true);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ2pdq-6EfGQj-CFeLdrDw" name="onGolB" specification="_ML9XYq-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>registrarGol(equipeB, jogadoresB, false);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ3QgK-6EfGQj-CFeLdrDw" name="registrarGol" specification="_MX_oQK-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZ3Qga-6EfGQj-CFeLdrDw" name="equipe" type="_MLbL4K-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ3Qgq-6EfGQj-CFeLdrDw" name="jogadores" type="_MV59kK-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ3Qg6-6EfGQj-CFeLdrDw" name="equipeAMarcou">
                    <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#boolean"/>
                  </ownedParameter>
                  <language>java</language>
                  <body>Jogador jogador = null;
     if (configuracaoDAO.getBoolean(&quot;indicar_autor_gol&quot;, true) &amp;&amp; !jogadores.isEmpty()) {
         jogador = escolherJogador(jogadores, &quot;Quem fez o gol?&quot;);
         if (jogador == null) {
             return; // cancelado
         }
     }

     if (equipeAMarcou) {
         placarA++;
     } else {
         placarB++;
     }
     atualizarPlacar();

     Evento evento = Evento.novoEvento(partida.getId(), jogador != null ? jogador.getId() : null,
             equipe.getId(), TipoEvento.GOL, periodoTexto(), tempoDecorridoSegundos());
     eventoDAO.salvar(evento);

     registrarLog(&quot;⚽ Gol de &quot; + equipe.getNome() + (jogador != null ? &quot; (&quot; + jogador.getNome() + &quot;)&quot; : &quot;&quot;)
             + &quot; — &quot; + placarA + &quot; x &quot; + placarB);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ3QhK-6EfGQj-CFeLdrDw" name="onAmareloA" specification="_ML_MkK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>registrarCartao(equipeA, jogadoresA, TipoEvento.CARTAO_AMARELO);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ3Qha-6EfGQj-CFeLdrDw" name="onAmareloB" specification="_ML_zoq-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>registrarCartao(equipeB, jogadoresB, TipoEvento.CARTAO_AMARELO);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ3Qhq-6EfGQj-CFeLdrDw" name="onVermelhoA" specification="_MMBBwK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>registrarCartao(equipeA, jogadoresA, TipoEvento.CARTAO_VERMELHO);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ3Qh6-6EfGQj-CFeLdrDw" name="onVermelhoB" specification="_MMBo0q-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>registrarCartao(equipeB, jogadoresB, TipoEvento.CARTAO_VERMELHO);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ33kK-6EfGQj-CFeLdrDw" name="registrarCartao" specification="_MYA2YK-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZ33ka-6EfGQj-CFeLdrDw" name="equipe" type="_MLbL4K-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ33kq-6EfGQj-CFeLdrDw" name="jogadores" type="_MV59kK-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ33k6-6EfGQj-CFeLdrDw" name="tipoCartao" type="_MJ_ogK-6EfGQj-CFeLdrDw"/>
                  <language>java</language>
                  <body>Jogador jogador = escolherJogador(jogadores, &quot;Cartão para qual jogador?&quot;);
     if (jogador == null) {
         return; // cartão sempre precisa de um jogador, para o controle de acúmulo
     }

     Evento evento = Evento.novoEvento(partida.getId(), jogador.getId(), equipe.getId(),
             tipoCartao, periodoTexto(), tempoDecorridoSegundos());
     eventoDAO.salvar(evento);

     String simbolo = tipoCartao == TipoEvento.CARTAO_AMARELO ? &quot;🟨&quot; : &quot;🟥&quot;;
     registrarLog(simbolo + &quot; Cartão para &quot; + jogador.getNome() + &quot; (&quot; + equipe.getNome() + &quot;)&quot;);

     if (tipoCartao == TipoEvento.CARTAO_AMARELO) {
         int quantidade = cartoesAmarelosPorJogador.merge(jogador.getId(), 1, Integer::sum);
         if (quantidade >= 2) {
             Evento vermelhoAutomatico = Evento.novoEvento(partida.getId(), jogador.getId(), equipe.getId(),
                     TipoEvento.CARTAO_VERMELHO, periodoTexto(), tempoDecorridoSegundos());
             eventoDAO.salvar(vermelhoAutomatico);
             registrarLog(&quot;🟥 &quot; + jogador.getNome() + &quot; levou o 2º amarelo — cartão vermelho automático.&quot;);
         }
     }
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ33lK-6EfGQj-CFeLdrDw" name="escolherJogador" specification="_MYCEga-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZ33la-6EfGQj-CFeLdrDw" name="jogadores" type="_MV59kK-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZ33lq-6EfGQj-CFeLdrDw" name="titulo">
                    <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                  </ownedParameter>
                  <ownedParameter xmi:id="_MZ33l6-6EfGQj-CFeLdrDw" type="_MLqccK-6EfGQj-CFeLdrDw" direction="return"/>
                  <language>java</language>
                  <body>if (jogadores == null || jogadores.isEmpty()) {
         return null;
     }
     ChoiceDialog&lt;Jogador> dialogo = new ChoiceDialog&lt;>(jogadores.get(0), jogadores);
     dialogo.setTitle(titulo);
     dialogo.setHeaderText(null);
     dialogo.setContentText(&quot;Jogador:&quot;);
     return dialogo.showAndWait().orElse(null);
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZ33mK-6EfGQj-CFeLdrDw" name="registrarLog" specification="_MMC28K-6EfGQj-CFeLdrDw">
