                <ownedAttribute xmi:id="_MYewcK-6EfGQj-CFeLdrDw" name="campoTexto" visibility="private" type="_MV0eAa-6EfGQj-CFeLdrDw" association="_MaXm0K-6EfGQj-CFeLdrDw"/>
