             + &quot;placar_a = ?, placar_b = ?, status = ? WHERE id = ?&quot;;
     try (Connection conn = DatabaseConnection.getConnection();
          PreparedStatement ps = conn.prepareStatement(sql)) {

         preencher(ps, partida);
         ps.setInt(8, partida.getId());
         ps.executeUpdate();
