              <packagedElement xmi:type="uml:Class" xmi:id="_ML0NcK-6EfGQj-CFeLdrDw" name="FutsalPlacarController">
                <ownedComment xmi:id="_MaGhEK-6EfGQj-CFeLdrDw">
                  <body>Controller da tela de placar do Futsal: cronômetro regressivo de dois
tempos, gols, cartões (amarelo acumulativo -> vermelho automático no
2º amarelo do mesmo jogador) e log de eventos em tempo real.</body>
                </ownedComment>
                <ownedAttribute xmi:id="_MY0HoK-6EfGQj-CFeLdrDw" name="DURACAO_TEMPO_SEGUNDOS" visibility="private" isLeaf="true" isStatic="true" isReadOnly="true">
