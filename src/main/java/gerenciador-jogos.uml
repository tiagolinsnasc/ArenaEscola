                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZxJ4K-6EfGQj-CFeLdrDw" name="preencher" specification="_MXzbAK-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZxJ4a-6EfGQj-CFeLdrDw" name="ps" type="_MWGx4K-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZxJ4q-6EfGQj-CFeLdrDw" name="jogador" type="_MLqccK-6EfGQj-CFeLdrDw"/>
                  <language>java</language>
                  <body>ps.setString(1, jogador.getNome());
     if (jogador.getNumero() != null) {
         ps.setInt(2, jogador.getNumero());
     } else {
         ps.setNull(2, Types.INTEGER);
     }
     ps.setString(3, jogador.getPosicao());
     ps.setString(4, jogador.getFotoPath());
     ps.setInt(5, jogador.getEquipeId());
 </body>
                </ownedBehavior>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZxJ46-6EfGQj-CFeLdrDw" name="mapear" specification="_MX0CEK-6EfGQj-CFeLdrDw">
