                <ownedAttribute xmi:id="_MYgloa-6EfGQj-CFeLdrDw" name="importadorLoteService" visibility="private" isLeaf="true" type="_MNHN8K-6EfGQj-CFeLdrDw" isReadOnly="true" association="_MaY08a-6EfGQj-CFeLdrDw">
                  <defaultValue xmi:type="uml:LiteralString" xmi:id="_MYgloq-6EfGQj-CFeLdrDw" value="new ImportadorLoteService()"/>
                </ownedAttribute>
                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZpOE6-6EfGQj-CFeLdrDw" name="onProcessar" specification="_MKGWMK-6EfGQj-CFeLdrDw">
                  <language>java</language>
                  <body>String texto = campoTexto.getText();
     if (texto == null || texto.isBlank()) {
         areaResultado.setText(&quot;Cole o texto no padrão indicado antes de processar.&quot;);
         return;
     }

     String log = importadorLoteService.importar(texto);
     areaResultado.setText(log.isBlank() ? &quot;Nada foi importado -- confira o padrão do texto.&quot; : log);
 </body>
                </ownedBehavior>
                <ownedOperation xmi:id="_MKGWMK-6EfGQj-CFeLdrDw" name="onProcessar" visibility="private" method="_MZpOE6-6EfGQj-CFeLdrDw"/>
              </packagedElement>
