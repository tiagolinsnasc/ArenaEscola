                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_MZutqa-6EfGQj-CFeLdrDw" value="*"/>
                  </ownedParameter>
                  <language>java</language>
                  <body>String sql = &quot;SELECT * FROM equipe ORDER BY nome&quot;;
     List&lt;Equipe> lista = new ArrayList&lt;>();
     try (Connection conn = DatabaseConnection.getConnection();
          Statement st = conn.createStatement();
          ResultSet rs = st.executeQuery(sql)) {

         while (rs.next()) {
             lista.add(mapear(rs));
         }
     } catch (SQLException e) {
         throw new RuntimeException(&quot;Erro ao listar equipes&quot;, e);
     }
     return lista;
 </body>
