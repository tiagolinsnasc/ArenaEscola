                <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_MZv7yK-6EfGQj-CFeLdrDw" name="mapear" specification="_MXyM4K-6EfGQj-CFeLdrDw">
                  <ownedParameter xmi:id="_MZv7ya-6EfGQj-CFeLdrDw" name="rs" type="_MWIAAK-6EfGQj-CFeLdrDw"/>
                  <ownedParameter xmi:id="_MZv7yq-6EfGQj-CFeLdrDw" type="_MLh5kK-6EfGQj-CFeLdrDw" direction="return"/>
                  <language>java</language>
                  <body>int jogadorId = rs.getInt(&quot;jogador_id&quot;);
     Integer jogadorIdObj = rs.wasNull() ? null : jogadorId;

     int minutoSegundos = rs.getInt(&quot;minuto_segundos&quot;);
     Integer minutoSegundosObj = rs.wasNull() ? null : minutoSegundos;

     return new Evento(
             rs.getInt(&quot;id&quot;),
             rs.getInt(&quot;partida_id&quot;),
             jogadorIdObj,
             rs.getInt(&quot;equipe_id&quot;),
             TipoEvento.valueOf(rs.getString(&quot;tipo&quot;)),
             rs.getString(&quot;periodo&quot;),
             minutoSegundosObj,
             LocalDateTime.parse(rs.getString(&quot;timestamp&quot;))
     );
 </body>
