                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_MY_t0q-6EfGQj-CFeLdrDw" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_MZAU4a-6EfGQj-CFeLdrDw" name="placarA" visibility="private">
