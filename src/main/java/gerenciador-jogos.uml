                <ownedAttribute xmi:id="_MY61UK-6EfGQj-CFeLdrDw" name="listaEventos" visibility="private" type="_MWw5Ma-6EfGQj-CFeLdrDw" association="_Maj0Ea-6EfGQj-CFeLdrDw"/>
                <ownedAttribute xmi:id="_MY8Dcq-6EfGQj-CFeLdrDw" name="eventoDAO" visibility="private" isLeaf="true" type="_MLGbwK-6EfGQj-CFeLdrDw" isReadOnly="true" association="_MalCMa-6EfGQj-CFeLdrDw">
