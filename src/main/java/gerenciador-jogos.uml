                  <body>return new Partida(
             rs.getInt(&quot;id&quot;),
             Modalidade.valueOf(rs.getString(&quot;modalidade&quot;)),
             rs.getInt(&quot;equipe_a_id&quot;),
             rs.getInt(&quot;equipe_b_id&quot;),
             LocalDateTime.parse(rs.getString(&quot;data_hora&quot;)),
             rs.getInt(&quot;placar_a&quot;),
