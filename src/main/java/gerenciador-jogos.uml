                  <language>java</language>
                  <body>int numero = rs.getInt(&quot;numero&quot;);
     Integer numeroObj = rs.wasNull() ? null : numero;

     return new Jogador(
             rs.getInt(&quot;id&quot;),
             rs.getString(&quot;nome&quot;),
             numeroObj,
             rs.getString(&quot;posicao&quot;),
             rs.getString(&quot;foto_path&quot;),
             rs.getInt(&quot;equipe_id&quot;)
     );
 </body>
