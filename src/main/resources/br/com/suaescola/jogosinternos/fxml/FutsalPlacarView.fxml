<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.suaescola.jogosinternos.controller.FutsalPlacarController"
           prefWidth="1000" prefHeight="680">

<BorderPane styleClass="root-pane">

    <top>
        <VBox alignment="CENTER" spacing="6" styleClass="painel-formulario">
            <padding>
                <Insets top="16" bottom="16" left="16" right="16"/>
            </padding>

            <HBox alignment="CENTER" spacing="24">
                <VBox alignment="CENTER" spacing="4">
                    <ImageView fx:id="escudoA" fitWidth="64" fitHeight="64" preserveRatio="true"/>
                    <Label fx:id="labelNomeA" styleClass="titulo-secao"/>
                </VBox>
                <Label fx:id="labelPlacar" text="0 x 0" styleClass="placar-grande"/>
                <VBox alignment="CENTER" spacing="4">
                    <ImageView fx:id="escudoB" fitWidth="64" fitHeight="64" preserveRatio="true"/>
                    <Label fx:id="labelNomeB" styleClass="titulo-secao"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="16">
                <Label fx:id="labelPeriodo" styleClass="texto-auxiliar"/>
                <Label fx:id="labelTempo" styleClass="cronometro"/>
                <Button fx:id="botaoIniciarPausar" text="Iniciar" onAction="#onIniciarPausar"/>
                <Button text="Avançar período" onAction="#onAvancarPeriodo"/>
                <Button text="Abrir Tela Pública" onAction="#onAbrirTelaPublica"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="14" bottom="14" left="20" right="20"/>
            </padding>

            <VBox spacing="10" alignment="TOP_CENTER" HBox.hgrow="ALWAYS" styleClass="painel-lista">
                <padding>
                    <Insets top="14" bottom="14" left="14" right="14"/>
                </padding>
                <Label text="Equipe A" styleClass="titulo-secao"/>
                <Button text="⚽ Gol" onAction="#onGolA" styleClass="card-button, card-destaque" prefWidth="200"/>
                <Button text="🟨 Cartão Amarelo" onAction="#onAmareloA" styleClass="card-button" prefWidth="200"/>
                <Button text="🟥 Cartão Vermelho" onAction="#onVermelhoA" styleClass="botao-perigo" prefWidth="200"/>

                <Label text="Eventos" styleClass="texto-auxiliar"/>
                <ListView fx:id="listaEventosA" VBox.vgrow="ALWAYS"/>
                <Button text="Remover evento selecionado" onAction="#onRemoverEventoA" styleClass="botao-perigo" prefWidth="200"/>
            </VBox>

            <VBox spacing="10" alignment="TOP_CENTER" HBox.hgrow="ALWAYS" styleClass="painel-lista">
                <padding>
                    <Insets top="14" bottom="14" left="14" right="14"/>
                </padding>
                <Label text="Equipe B" styleClass="titulo-secao"/>
                <Button text="⚽ Gol" onAction="#onGolB" styleClass="card-button, card-destaque" prefWidth="200"/>
                <Button text="🟨 Cartão Amarelo" onAction="#onAmareloB" styleClass="card-button" prefWidth="200"/>
                <Button text="🟥 Cartão Vermelho" onAction="#onVermelhoB" styleClass="botao-perigo" prefWidth="200"/>

                <Label text="Eventos" styleClass="texto-auxiliar"/>
                <ListView fx:id="listaEventosB" VBox.vgrow="ALWAYS"/>
                <Button text="Remover evento selecionado" onAction="#onRemoverEventoB" styleClass="botao-perigo" prefWidth="200"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="painel-formulario">
            <padding>
                <Insets top="10" bottom="16" left="16" right="16"/>
            </padding>
            <Button text="Encerrar Partida" onAction="#onEncerrarPartida" styleClass="botao-perigo" prefWidth="180" prefHeight="40"/>
        </HBox>
    </bottom>

</BorderPane>

    <ImageView fx:id="logoEscola" fitWidth="64" fitHeight="64" preserveRatio="true"
               StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets top="10" left="10"/>
        </StackPane.margin>
    </ImageView>

</StackPane>
