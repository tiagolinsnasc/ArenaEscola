<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.suaescola.jogosinternos.controller.CadastroEquipesController"
            styleClass="root-pane" prefWidth="820" prefHeight="520">

    <left>
        <VBox spacing="10" styleClass="painel-lista" prefWidth="380">
            <padding>
                <Insets top="16" bottom="16" left="16" right="16"/>
            </padding>

            <Label text="Equipes cadastradas" styleClass="titulo-secao"/>

            <TableView fx:id="tabelaEquipes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="220"/>
                    <TableColumn fx:id="colModalidade" text="Modalidade" prefWidth="130"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button text="Nova Equipe" onAction="#onNovo"/>
                <Button text="Excluir" onAction="#onExcluir" styleClass="botao-perigo"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" alignment="TOP_CENTER" styleClass="painel-formulario">
            <padding>
                <Insets top="24" bottom="24" left="24" right="24"/>
            </padding>

            <Label text="Dados da equipe" styleClass="titulo-secao"/>

            <ImageView fx:id="previewEscudo" fitWidth="96" fitHeight="96" preserveRatio="true"/>
            <Button text="Escolher escudo..." onAction="#onEscolherImagem"/>
            <Label fx:id="labelEscudo" text="Nenhuma imagem selecionada" styleClass="texto-auxiliar"/>
            <Label text="Sugestão: imagem quadrada, 300x300px ou mais, fundo transparente (PNG) se possível"
                   styleClass="texto-auxiliar" wrapText="true" maxWidth="260" alignment="CENTER" textAlignment="CENTER"/>

            <Label text="Nome da equipe"/>
            <TextField fx:id="campoNome" promptText="Ex.: Turma 9A" maxWidth="260"/>

            <Label text="Modalidade"/>
            <ComboBox fx:id="comboModalidade" prefWidth="200"/>

            <Button text="Salvar" onAction="#onSalvar" styleClass="card-button, card-destaque" prefWidth="160"/>
        </VBox>
    </center>

</BorderPane>
