<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.suaescola.jogosinternos.controller.ConfiguracoesController"
      styleClass="root-pane" spacing="16" prefWidth="480" prefHeight="360">

    <padding>
        <Insets top="24" bottom="24" left="28" right="28"/>
    </padding>

    <Label text="Configurações" styleClass="titulo-secao"/>
    <Label text="Essas opções valem para as próximas partidas iniciadas (futsal e vôlei)."
           styleClass="texto-auxiliar" wrapText="true"/>

    <CheckBox fx:id="checkIndicarGol" text="Indicar quem fez o gol/ponto ao marcar"/>
    <CheckBox fx:id="checkIndicarBloqueio" text="Indicar quem fez o bloqueio (vôlei)"/>
    <CheckBox fx:id="checkExigirCartao" text="Exigir jogador ao lançar um cartão"/>
    <CheckBox fx:id="checkAbrirTelaPublica" text="Abrir a tela pública (telão) automaticamente ao iniciar a partida"/>

    <Button text="Salvar" onAction="#onSalvar" styleClass="card-button, card-destaque" prefWidth="140"/>

</VBox>
