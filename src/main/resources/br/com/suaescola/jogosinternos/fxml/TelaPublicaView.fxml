<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.suaescola.jogosinternos.controller.TelaPublicaController"
           prefWidth="1100" prefHeight="650">

<BorderPane styleClass="tela-publica-fundo">

    <center>
        <HBox alignment="CENTER" spacing="50">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>

            <VBox alignment="TOP_CENTER" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView fx:id="escudoA" fitWidth="190" fitHeight="190" preserveRatio="true"/>
                <Label fx:id="labelNomeA" styleClass="tp-nome-equipe"/>
                <ListView fx:id="listaEventosA" styleClass="tp-eventos-lista" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="6">
                <Label fx:id="labelPeriodo" styleClass="tp-periodo"/>
                <Label fx:id="labelPlacar" styleClass="tp-placar"/>
                <Label fx:id="labelTempo" styleClass="tp-tempo"/>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView fx:id="escudoB" fitWidth="190" fitHeight="190" preserveRatio="true"/>
                <Label fx:id="labelNomeB" styleClass="tp-nome-equipe"/>
                <ListView fx:id="listaEventosB" styleClass="tp-eventos-lista" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>

    <ImageView fx:id="logoEscola" fitWidth="90" fitHeight="90" preserveRatio="true"
               StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets top="16" left="16"/>
        </StackPane.margin>
    </ImageView>

</StackPane>
