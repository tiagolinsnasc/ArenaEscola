<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.CheckListView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.suaescola.jogosinternos.controller.NovaPartidaController"
            styleClass="root-pane" prefWidth="900" prefHeight="560">

    <top>
        <VBox spacing="8" alignment="CENTER" styleClass="painel-formulario">
            <padding>
                <Insets top="20" bottom="14" left="20" right="20"/>
            </padding>
            <Label text="Nova Partida" styleClass="titulo-secao"/>
            <HBox spacing="10" alignment="CENTER">
                <Label text="Modalidade:"/>
                <ComboBox fx:id="comboModalidade" prefWidth="160"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="10" bottom="10" left="20" right="20"/>
            </padding>

            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="painel-lista">
                <padding>
                    <Insets top="14" bottom="14" left="14" right="14"/>
                </padding>
                <Label text="Equipe A"/>
                <ComboBox fx:id="comboEquipeA" prefWidth="240"/>
                <Label text="Titulares em quadra" styleClass="texto-auxiliar"/>
                <CheckListView fx:id="listaJogadoresA" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="painel-lista">
                <padding>
                    <Insets top="14" bottom="14" left="14" right="14"/>
                </padding>
                <Label text="Equipe B"/>
                <ComboBox fx:id="comboEquipeB" prefWidth="240"/>
                <Label text="Titulares em quadra" styleClass="texto-auxiliar"/>
                <CheckListView fx:id="listaJogadoresB" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="painel-formulario">
            <padding>
                <Insets top="14" bottom="20" left="20" right="20"/>
            </padding>
            <Button text="Iniciar Partida" onAction="#onIniciarPartida" styleClass="card-button, card-destaque" prefWidth="200" prefHeight="44"/>
        </HBox>
    </bottom>

</BorderPane>
